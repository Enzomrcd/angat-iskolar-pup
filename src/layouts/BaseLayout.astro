---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import SeasonalAtmosphere from '../components/SeasonalAtmosphere.astro';
// CORRECTED IMPORT FOR ASTRO v5+
import { ClientRouter } from 'astro:transitions';

interface Props {
    title?: string;
}

const { title = "Angat Iskolar PUP" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/png" href="/images/logos/icon_logo.png" />
        <title>{title}</title>

        <!-- Zero-Flash Philippine Occasion Theme Detector -->
        <script is:inline>
            (function () {
                function detectPhOccasionId() {
                    const phDateStr = new Date().toLocaleDateString('en-US', {
                        timeZone: 'Asia/Manila',
                        month: 'numeric',
                        day: 'numeric',
                    });
                    const [month, day] = phDateStr.split('/').map(Number);

                    if ((month === 12 && day === 31) || (month === 1 && day <= 7)) return 'bagong-taon';
                    if (month === 6 && day >= 10 && day <= 14) return 'kalayaan';
                    if (month === 6) return 'pride';
                    if (month === 8) return 'buwan-ng-wika';
                    if (month === 10 && day >= 1 && day <= 10) return 'anniversary';
                    if ((month === 10 && day >= 28) || (month === 11 && day <= 3)) return 'undas';
                    if (month === 12 && day <= 30) return 'pasko';
                    return 'default';
                }

                function syncInitialTheme() {
                    const pref = localStorage.getItem('aip-theme-pref') || 'auto';
                    const resolved = pref === 'auto' ? detectPhOccasionId() : pref;
                    if (resolved === 'default') {
                        document.documentElement.removeAttribute('data-theme');
                    } else {
                        document.documentElement.setAttribute('data-theme', resolved);
                    }
                }

                syncInitialTheme();
                document.addEventListener('astro:after-swap', syncInitialTheme);
            })();
        </script>
        
        <!-- Enable Smooth Page Transitions -->
        <ClientRouter />

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@700&display=swap" rel="stylesheet">
    </head>
    <body class="min-h-screen flex flex-col relative bg-gray-50/30">
        <!-- Injected Header -->
        <Header />
        
        <!-- Main Content Wrapper with fade-in animation on load -->
        <main class="flex-grow animate-fade-in-up">
            <slot />
        </main>

        <!-- Injected Footer -->
        <Footer />

        <!-- Floating Philippine Seasonal Theme Switcher & Ambient Atmosphere -->
        <SeasonalAtmosphere />
        <ThemeSwitcher />
        
        <!-- Script for Scroll Animations -->
        <script>
            // This script watches elements as they scroll into view and triggers their animation
            function setupScrollAnimations() {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('opacity-100', 'translate-y-0');
                            entry.target.classList.remove('opacity-0', 'translate-y-8');
                            // Stop observing once animated in
                            observer.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.1 }); // Triggers when 10% of the element is visible

                // Select all elements with the 'scroll-animate' class
                const hiddenElements = document.querySelectorAll('.scroll-animate');
                hiddenElements.forEach((el) => observer.observe(el));
            }

            // Run on initial load
            setupScrollAnimations();

            // Run again whenever Astro swaps pages using ClientRouter
            document.addEventListener('astro:after-swap', setupScrollAnimations);
        </script>
    </body>
</html>