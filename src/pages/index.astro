---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { getEntry } from 'astro:content';

// Fetch the subtitle from your global CMS settings
const globalSettings = await getEntry('settings', 'global');
const homeSubtitle = globalSettings?.data?.home_subtitle || "Iskolar para sa Bayan";
---

<BaseLayout title="Home | Angat Iskolar PUP">
    <!-- Main Hero Section -->
    <Hero title="ANGAT ISKOLAR PUP">
        <p class="text-xl md:text-2xl font-light italic mt-2 opacity-90 tracking-wide">"{homeSubtitle}"</p>
    </Hero>

    <!-- Main Content -->
    <div class="w-full bg-white relative z-10 overflow-hidden">
        <!-- Decorative subtle background gradient -->
        <div class="absolute top-0 right-0 w-full h-full bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-aip-plum/5 via-transparent to-transparent pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-6 py-20 md:py-32 flex flex-col gap-24 md:gap-32">
            
            <!-- Section 1: Bayanihan Hub -->
            <div class="flex flex-col md:flex-row items-center gap-12 md:gap-20">
                <div class="flex-1 animate-fade-in-up delay-0">
                    <div class="inline-block bg-aip-plum/10 text-aip-plum font-bold px-4 py-1.5 rounded-full uppercase tracking-wider text-xs mb-6">
                        AIP Connect 2026
                    </div>
                    <h2 class="text-3xl md:text-4xl font-bold text-aip-cerise leading-tight mb-6">
                        Welcome to the Bayanihan Hub!
                    </h2>
                    <p class="text-lg text-gray-600 leading-relaxed mb-4">
                        A digital home for the stories, people, and initiatives of ANGAT Iskolar PUP.
                    </p>
                    <p class="text-lg text-gray-600 leading-relaxed">
                        Discover our journey, celebrate our volunteers, and explore the collective efforts that continue to bring our spirit of bayanihan to life.
                    </p>
                </div>
                
                <!-- Graphic / Image Placeholder -->
                <div class="flex-1 w-full relative animate-fade-in-up delay-100">
                    <div class="aspect-[4/3] rounded-[2.5rem] bg-gray-50 border-2 border-dashed border-gray-200 flex flex-col items-center justify-center overflow-hidden relative group shadow-inner">
                        <div class="absolute inset-0 bg-gradient-to-tr from-aip-cerise/5 to-aip-plum/5"></div>
                        <svg class="w-16 h-16 text-gray-300 group-hover:scale-110 group-hover:text-aip-cerise/50 transition-all duration-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                        <span class="text-sm font-bold text-gray-400 uppercase tracking-widest">[Image Placeholder]</span>
                    </div>
                    <!-- Decorative background blur shapes -->
                    <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-aip-cerise/20 rounded-full blur-3xl -z-10"></div>
                    <div class="absolute -top-6 -right-6 w-32 h-32 bg-aip-plum/20 rounded-full blur-3xl -z-10"></div>
                </div>
            </div>

            <!-- Section 2: Serving the People -->
            <div class="flex flex-col md:flex-row-reverse items-center gap-12 md:gap-20">
                <div class="flex-1 animate-fade-in-up delay-200">
                    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 leading-tight mb-6 uppercase tracking-wide">
                        Serving the People, Together.
                    </h2>
                    <div class="w-24 h-1.5 bg-gradient-to-r from-aip-cerise to-aip-punch mb-8 rounded-full"></div>
                    <p class="text-lg text-gray-600 leading-relaxed mb-6">
                        ANGAT Iskolar PUP is a student-led organization committed to developing young leaders through volunteerism, community engagement, and service-centered leadership.
                    </p>
                    <p class="text-lg text-gray-600 leading-relaxed">
                        Together, we turn the ideals of the Volunteer ng Bayan into meaningful action for the people and the country.
                    </p>
                </div>
                
                <!-- Core Values Grid -->
                <div class="flex-1 w-full animate-fade-in-up delay-300">
                    <div class="grid grid-cols-2 gap-4 md:gap-6 items-center">
                        <div class="bg-white rounded-3xl p-6 md:p-8 flex flex-col items-center justify-center text-center shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-gray-100">
                            <div class="bg-aip-cerise/10 p-4 rounded-full mb-4">
                                <svg class="w-8 h-8 text-aip-cerise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                            </div>
                            <h4 class="font-bold text-gray-900 uppercase tracking-wide text-sm md:text-base">Volunteerism</h4>
                        </div>
                        
                        <div class="bg-white rounded-3xl p-6 md:p-8 flex flex-col items-center justify-center text-center shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-gray-100">
                            <div class="bg-aip-plum/10 p-4 rounded-full mb-4">
                                <svg class="w-8 h-8 text-aip-plum" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                            </div>
                            <h4 class="font-bold text-gray-900 uppercase tracking-wide text-sm md:text-base">Community</h4>
                        </div>
                        
                        <div class="bg-white rounded-3xl p-6 md:p-8 flex flex-col items-center justify-center text-center shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-gray-100">
                            <div class="bg-aip-cerise/10 p-4 rounded-full mb-4">
                                <svg class="w-8 h-8 text-aip-cerise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
                            </div>
                            <h4 class="font-bold text-gray-900 uppercase tracking-wide text-sm md:text-base">Leadership</h4>
                        </div>
                        
                        <div class="bg-white rounded-3xl p-6 md:p-8 flex flex-col items-center justify-center text-center shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-gray-100">
                            <div class="bg-aip-plum/10 p-4 rounded-full mb-4">
                                <svg class="w-8 h-8 text-aip-plum" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"></path></svg>
                            </div>
                            <h4 class="font-bold text-gray-900 uppercase tracking-wide text-sm md:text-base">Action</h4>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</BaseLayout>