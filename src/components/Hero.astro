---
// src/components/Hero.astro
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="relative w-full h-[500px] md:h-[600px] aip-hero-gradient flex flex-col justify-center px-8 md:px-16 pt-20 pb-16">
    <!-- Wavy divider with smoothed bezier path -->
    <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none pointer-events-none transform translate-y-[1px]">
        <svg class="relative block w-full h-[60px] md:h-[100px] scale-y-105 origin-bottom" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M0,40 C220,95 440,15 660,50 C880,85 1060,25 1200,35 L1200,120 L0,120 Z" fill="#ffffff"></path>
        </svg>
    </div>

    <!-- Hero Text -->
    <div class="relative z-10 text-white max-w-4xl">
        <h1 class="text-3xl md:text-5xl lg:text-6xl mb-2 font-bold tracking-wide uppercase leading-tight">
            {title}
        </h1>
        <!-- Slot allows us to insert subtitles below the title on specific pages -->
        <slot /> 
    </div>
</div>