---
// src/components/Header.astro
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: "HOME", url: "/" },
  { name: "ABOUT US", url: "/about-us" },
  { name: "OUR PEOPLE", url: "/our-people" },
  { name: "AIP COMMUNITY", url: "/community" },
  { name: "PROGRAMS & IMPACT", url: "/programs-impact" },
  { name: "ARCHIVES", url: "/archives" },
  { name: "GET INVOLVED", url: "/get-involved" },
];
---

<header class="absolute top-0 left-0 w-full z-50 px-4 md:px-8 py-6 flex items-center justify-between text-white">
  <!-- Left side: Logo & Desktop Search -->
  <div class="flex items-center gap-4 xl:gap-6">
    <!-- Ensure Logo stays above mobile overlay -->
    <a href="/" aria-label="Home" class="flex-shrink-0 relative z-50">
      <img src="/images/logos/main_logo.png" alt="Angat Iskolar PUP Logo" class="h-10 md:h-12 w-auto" />
    </a>
    
    <!-- Desktop Search (Hidden on Mobile) -->
    <div class="relative hidden md:block">
      <span class="absolute inset-y-0 left-0 flex items-center pl-3">
        <svg class="w-4 h-4 md:w-5 md:h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </span>
      <input 
        type="text" 
        placeholder="Search" 
        class="pl-10 pr-4 py-1.5 md:py-2 rounded-full bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-aip-cerise w-48 lg:w-64 shadow-md text-sm"
      />
    </div>
  </div>

  <!-- Right side: Desktop Navigation Links (Hidden on Mobile) -->
  <nav class="hidden xl:flex items-center">
    <ul class="flex items-center space-x-1">
      {navLinks.map((link) => {
        const normalizedPath = currentPath.replace(/\/$/, '') || '/';
        const isActive = normalizedPath === link.url;
        
        return (
          <li>
            <a 
              href={link.url} 
              class={`px-3 py-2 rounded-full text-xs lg:text-sm font-bold tracking-wide whitespace-nowrap transition-colors ${
                isActive 
                  ? 'bg-aip-cerise text-white shadow-md' 
                  : 'hover:bg-white/20'
              }`}
            >
              {link.name}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <!-- Mobile Menu Toggle Button (Visible only on Mobile) -->
  <button id="mobile-menu-btn" class="xl:hidden relative z-50 p-2 text-white focus:outline-none" aria-label="Toggle Menu">
    <!-- Hamburger Icon -->
    <svg id="icon-menu" class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
    <!-- Close (X) Icon (Hidden by default) -->
    <svg id="icon-close" class="w-8 h-8 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu" class="fixed inset-0 bg-aip-plum bg-opacity-95 z-40 hidden flex-col items-center justify-center pt-20 pb-8 overflow-y-auto">
    <!-- Mobile Search -->
    <div class="relative w-3/4 max-w-sm mb-8">
      <span class="absolute inset-y-0 left-0 flex items-center pl-3">
        <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </span>
      <input 
        type="text" 
        placeholder="Search" 
        class="w-full pl-10 pr-4 py-3 rounded-full bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-aip-cerise shadow-md text-base"
      />
    </div>

    <!-- Mobile Navigation Links -->
    <nav class="flex flex-col items-center space-y-4 w-full px-6">
      {navLinks.map((link) => {
        const normalizedPath = currentPath.replace(/\/$/, '') || '/';
        const isActive = normalizedPath === link.url;
        
        return (
          <a 
            href={link.url} 
            class={`w-full text-center px-6 py-3 rounded-full text-base font-bold tracking-wide transition-colors ${
              isActive 
                ? 'bg-aip-cerise text-white shadow-md' 
                : 'text-white hover:bg-white/10'
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<!-- Script to handle mobile menu toggling -->
<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');
  const body = document.body;

  if (btn && menu && iconMenu && iconClose) {
    btn.addEventListener('click', () => {
      // Toggle menu visibility
      menu.classList.toggle('hidden');
      menu.classList.toggle('flex');
      
      // Toggle icons
      iconMenu.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
      
      // Prevent body scrolling when menu is open
      body.classList.toggle('overflow-hidden');
    });
  }
</script>