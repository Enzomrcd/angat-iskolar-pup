---
// src/components/SeasonalAtmosphere.astro
---

<!-- Full-Viewport Non-Blocking Ambient Layer -->
<div
  id="aip-seasonal-stage"
  aria-hidden="true"
  style="position: fixed; inset: 0; pointer-events: none; z-index: 30; overflow: hidden;"
  class="select-none"
>
  <!-- Dynamic SVG Cultural Corner Motif (Top-Right Hero Accent) -->
  <div id="aip-seasonal-motif" class="absolute top-20 right-4 sm:right-10 md:right-16 opacity-90 transition-opacity duration-500"></div>

  <!-- Dynamic Ambient Particles Container -->
  <div id="aip-seasonal-particles" class="absolute inset-0"></div>
</div>

<!-- Dismissible Cultural Greeting Toast (Strictly Viewport-Locked) -->
<div
  id="aip-seasonal-greeting"
  style="position: fixed; z-index: 9990; transform: none;"
  class="hidden bottom-20 sm:bottom-5 left-4 right-4 sm:right-auto sm:left-5 sm:max-w-md bg-white border border-gray-200 shadow-2xl rounded-2xl px-4 py-3 flex items-start gap-3"
>
  <span id="aip-greeting-icon" class="text-xl flex-shrink-0 mt-0.5">✨</span>
  <div class="min-w-0 flex-1">
    <p id="aip-greeting-title" class="text-xs font-bold uppercase tracking-wider text-aip-cerise leading-tight"></p>
    <p id="aip-greeting-text" class="text-xs sm:text-sm text-gray-700 leading-snug mt-1"></p>
  </div>
  <button
    type="button"
    id="aip-greeting-dismiss"
    aria-label="Dismiss seasonal greeting"
    class="text-gray-400 hover:text-gray-700 text-xs font-bold p-1 -mr-1 -mt-0.5 flex-shrink-0 cursor-pointer touch-manipulation"
  >
    ✕
  </button>
</div>

<script>
  interface ThemeAtmosphereConfig {
    greetingTitle: string;
    greetingText: string;
    greetingIcon: string;
    motifSVG: string;
    particles: {
      direction: 'fall' | 'rise';
      count: number;
      shapes: string[];
    };
  }

  const ATMOSPHERES: Record<string, ThemeAtmosphereConfig> = {
    pasko: {
      greetingTitle: 'Maligayang Pasko!',
      greetingText: 'Isang mapagpalang Paskong Pinoy, mga Iskolar!',
